{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{ range .Data.Pages }}
  {{ $section := .Section }}
  {{ $priority := 0.5 }}
  {{ $changefreq := "monthly" }}
  {{ if .IsHome }}
    {{ $priority = 1.0 }}
    {{ $changefreq = "weekly" }}
  {{ else if .IsSection }}
    {{ $priority = 0.8 }}
    {{ $changefreq = "weekly" }}
  {{ else if eq $section "guides" }}
    {{ $priority = 0.8 }}
    {{ $changefreq = "monthly" }}
  {{ else if eq $section "comparisons" }}
    {{ $priority = 0.8 }}
    {{ $changefreq = "monthly" }}
  {{ else if eq $section "patterns" }}
    {{ $priority = 0.7 }}
    {{ $changefreq = "monthly" }}
  {{ else if eq $section "case-patterns" }}
    {{ $priority = 0.7 }}
    {{ $changefreq = "monthly" }}
  {{ else if eq $section "architecture" }}
    {{ $priority = 0.7 }}
    {{ $changefreq = "monthly" }}
  {{ else if eq $section "foundations" }}
    {{ $priority = 0.7 }}
    {{ $changefreq = "monthly" }}
  {{ else if eq $section "frameworks" }}
    {{ $priority = 0.7 }}
    {{ $changefreq = "monthly" }}
  {{ else if eq $section "solutions" }}
    {{ $priority = 0.7 }}
    {{ $changefreq = "monthly" }}
  {{ else if eq $section "tools" }}
    {{ $priority = 0.6 }}
    {{ $changefreq = "monthly" }}
  {{ else if eq $section "glossary" }}
    {{ $priority = 0.6 }}
    {{ $changefreq = "yearly" }}
  {{ else if eq $section "ideas" }}
    {{ $priority = 0.4 }}
    {{ $changefreq = "yearly" }}
  {{ end }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{ if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>
    {{ else if not .Date.IsZero }}
    <lastmod>{{ safeHTML ( .Date.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>
    {{ end }}
    <changefreq>{{ $changefreq }}</changefreq>
    <priority>{{ $priority }}</priority>
  </url>
  {{ end }}
</urlset>
