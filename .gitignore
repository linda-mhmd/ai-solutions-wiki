# Hugo build output
public/
resources/_gen/
.hugo_build.lock

# Search index (generated by: hugo && npx pagefind --site public && cp -r public/pagefind static/pagefind)
# Rebuild before each deploy — do not commit
static/pagefind/

# OS and editor files
.DS_Store
*.swp
*.swo
*~

# Dependencies
node_modules/

# IDE configs
.vscode/
.kiro/
.idea/

# Claude Code session and project files. The skills directory is committed on
# purpose: .claude/skills/weekly-wiki-update is what the scheduled workflow
# runs, so it has to be in the repository the runner checks out.
.claude/*
!.claude/skills/
CLAUDE.md

# Scripts with sensitive operations
scripts/

# Source/working files — not served by the site
# Store these in Google Drive or Dropbox instead
input/
ai-solutions (1).zip

# Playwright MCP browser-automation artifacts (console logs, page snapshots)
.playwright-mcp/
perplexity-snapshot.md
blog-screenshots/ai-solutions-wiki-post.html

# Review and session leftovers: screenshots, superseded drafts and setup
# scripts that never belong in the repository
Claude outputs/
/weekly-update.yml
docs/weekly-update.md
ci/bootstrap-preview-repo.sh
